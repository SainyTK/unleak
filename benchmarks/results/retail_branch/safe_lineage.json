{
  "artifact_path": "benchmarks/results/retail_branch/safe_artifact.json",
  "fields": {
    "branch_alias": {
      "ancestors": [
        "branch_metrics.branch_name"
      ],
      "transforms": [
        "alias"
      ]
    },
    "health_index": {
      "ancestors": [
        "branch_metrics.revenue"
      ],
      "transforms": [
        "median_relative_index"
      ]
    },
    "risk_band": {
      "ancestors": [
        "branch_metrics.revenue",
        "branch_metrics.returns_rate"
      ],
      "transforms": [
        "bucket"
      ]
    },
    "trend_percentile": {
      "ancestors": [
        "branch_metrics.revenue"
      ],
      "transforms": [
        "percentile_rank"
      ]
    }
  },
  "group_sizes": {
    "RB-001": 420,
    "RB-002": 360,
    "RB-003": 290,
    "RB-004": 315,
    "RB-005": 305,
    "RB-006": 395
  }
}
