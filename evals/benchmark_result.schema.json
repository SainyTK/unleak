{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unleak.local/evals/benchmark_result.schema.json",
  "title": "Unleak Benchmark Summary",
  "type": "object",
  "required": ["harness_version", "scenario_count", "schema_path", "results"],
  "properties": {
    "harness_version": {
      "type": "integer",
      "minimum": 1
    },
    "scenario_count": {
      "type": "integer",
      "minimum": 1
    },
    "schema_path": {
      "type": "string"
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "scenario_id",
          "title",
          "description",
          "raw_fixture",
          "policy",
          "expected",
          "snapshots",
          "metrics"
        ],
        "properties": {
          "scenario_id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "raw_fixture": { "type": "string" },
          "policy": { "type": "string" },
          "expected": { "type": "string" },
          "snapshots": {
            "type": "object",
            "required": [
              "safe_artifact",
              "safe_lineage",
              "safe_validation",
              "blocked_artifact",
              "blocked_lineage",
              "blocked_validation"
            ],
            "additionalProperties": { "type": "string" }
          },
          "metrics": {
            "type": "object",
            "required": ["task_completion", "utility", "leakage", "execution"],
            "properties": {
              "task_completion": {
                "type": "object",
                "required": ["safe_release_valid", "blocked_release_rejected"],
                "properties": {
                  "safe_release_valid": { "type": "boolean" },
                  "blocked_release_rejected": { "type": "boolean" }
                }
              },
              "utility": {
                "type": "object",
                "required": [
                  "focus",
                  "raw_bottom_entities",
                  "safe_overlap_count",
                  "safe_overlap_ratio",
                  "safe_bottom_real_names"
                ],
                "properties": {
                  "focus": { "type": "string" },
                  "raw_bottom_entities": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "safe_overlap_count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "safe_overlap_ratio": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "safe_bottom_real_names": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                }
              },
              "leakage": {
                "type": "object",
                "required": [
                  "baseline_prompt_mode",
                  "baseline_exposed_high_risk_fields",
                  "baseline_leakage_rate",
                  "sanitized_release_ok",
                  "sanitized_violation_count",
                  "blocked_release_ok",
                  "blocked_violation_count",
                  "blocked_violation_samples"
                ],
                "properties": {
                  "baseline_prompt_mode": { "type": "string" },
                  "baseline_exposed_high_risk_fields": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "baseline_leakage_rate": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "sanitized_release_ok": { "type": "boolean" },
                  "sanitized_violation_count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "blocked_release_ok": { "type": "boolean" },
                  "blocked_violation_count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "blocked_violation_samples": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                }
              },
              "execution": {
                "type": "object",
                "required": ["raw_row_count", "safe_entity_count", "minimum_group_size"],
                "properties": {
                  "raw_row_count": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "safe_entity_count": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "minimum_group_size": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
